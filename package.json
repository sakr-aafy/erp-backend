{
  "name": "erp-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:init": "tsx src/scripts/db-init.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "db:indexes": "tsx src/scripts/db-indexes.ts",
    "db:seed-perf": "tsx src/scripts/seed-perf.ts",
    "db:e2e-reset": "tsx src/scripts/e2e-reset.ts",
    "perf": "tsx src/scripts/perf-measure.ts",
    "perf:explain": "tsx src/scripts/perf-explain.ts",
    "lint": "eslint src tests",
    "db:migrate-customers": "tsx src/scripts/migrate-customers.ts"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.10",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.12.2",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0",
    "pdfkit": "^0.20.2",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
