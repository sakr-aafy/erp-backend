NODE_ENV=development
PORT=3000
# Local : replica set rs0 (transactions). Atlas : mongodb+srv://user:pass@cluster.mongodb.net/erp
MONGO_URI=mongodb://127.0.0.1:27017/erp?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-xxxxxxxx
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars-xxxxxxx
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGIN=http://localhost:4200
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
# Seed initial (npm run db:seed)
SEED_COMPANY_NAME=Ma Société
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=''  # saisir un mot de passe conforme (entre quotes)

# URL publique du frontend (liens dans les e-mails)
APP_URL=http://localhost:4200
# --- SMTP (laisser SMTP_HOST vide = e-mails désactivés ; en production la réinitialisation de mot de passe est alors indisponible)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ERP <no-reply@votre-domaine.tn>"
# Dev uniquement : journaliser le lien de réinitialisation si SMTP absent
DEV_LOG_RESET_TOKEN=false
# --- Production : COOKIE_SECURE=true, CORS_ORIGIN=https://..., APP_URL=https://..., secrets JWT aléatoires distincts (openssl rand -hex 32)
# --- Limitation de débit (par IP) : globale (requêtes/minute) et authentification (tentatives / 15 min ; défaut strict 20)
RATE_LIMIT_PER_MIN=300
AUTH_RATE_LIMIT_MAX=20
# --- Documentation Swagger (/api/docs) : désactivée par défaut en production ; true/false pour forcer
#SWAGGER_ENABLED=false

